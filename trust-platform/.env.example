# Public Supabase client settings. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Must match the app URL that Supabase Auth and transactional email links use.
APP_URL=http://localhost:3000

# Use different random secrets in every environment:
# openssl rand -base64 48
TOKEN_PEPPER=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-32-random-characters

# Optional locally. Required by beta:check-env:prod for private beta.
# Comma or newline separated exact professional account emails.
BETA_ALLOWED_EMAILS=founder@example.com,design-partner@example.com

# Local development: smtp + Supabase/Mailpit.
# Simple private beta: manual link delivery.
# Email-enabled beta: resend + verified sender domain.
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
MAIL_FROM=Trust Platform <no-reply@example.test>
RESEND_API_KEY=
